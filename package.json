{
  "name": "casatube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted media downloader that does not lose your work",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@tanstack/react-query": "^5.102.4",
    "@tanstack/react-router": "^1.170.32",
    "better-result": "^3.0.1",
    "bun-plugin-tailwind": "^0.1.2",
    "bunqueue": "^2.8.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "filenamify": "^7.0.2",
    "hls.js": "^1.7.1",
    "lucide-react": "^1.34.0",
    "media-chrome": "^4.19.2",
    "ohash": "^2.0.12",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  }
}
